<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>

<%--
  Conexión flexible.
  En Clever Cloud toma los datos del add-on MySQL (variables MYSQL_ADDON_*).
  En local, si esas variables no existen, cae en localhost/root/empleados.
--%>
<sql:setDataSource var="empleados"
                   driver="com.mysql.cj.jdbc.Driver"
                   url="jdbc:mysql://${empty env['MYSQL_ADDON_HOST'] ? 'localhost' : env['MYSQL_ADDON_HOST']}:${empty env['MYSQL_ADDON_PORT'] ? '3306' : env['MYSQL_ADDON_PORT']}/${empty env['MYSQL_ADDON_DB'] ? 'empleados' : env['MYSQL_ADDON_DB']}?useUnicode=true&amp;characterEncoding=utf8&amp;useSSL=false&amp;allowPublicKeyRetrieval=true"
                   user="${empty env['MYSQL_ADDON_USER'] ? 'root' : env['MYSQL_ADDON_USER']}"
                   password="${empty env['MYSQL_ADDON_PASSWORD'] ? '' : env['MYSQL_ADDON_PASSWORD']}" />

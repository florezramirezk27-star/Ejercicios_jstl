<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>

<%--
  Conexion a MySQL (Guia 2024).
  En Clever Cloud toma los datos del add-on MySQL (variables de entorno MYSQL_ADDON_*).
  En local, si esas variables no existen, usa XAMPP: localhost / root / base 'empleados'.
--%>
<%
    String dbHost = System.getenv("MYSQL_ADDON_HOST");
    String dbPort = System.getenv("MYSQL_ADDON_PORT");
    String dbName = System.getenv("MYSQL_ADDON_DB");
    String dbUser = System.getenv("MYSQL_ADDON_USER");
    String dbPass = System.getenv("MYSQL_ADDON_PASSWORD");

    if (dbHost == null || dbHost.trim().isEmpty()) {
        dbHost = "localhost";
        dbPort = "3306";
        dbName = "empleados";
        dbUser = "root";
        dbPass = "";
    }
    if (dbPort == null || dbPort.trim().isEmpty()) {
        dbPort = "3306";
    }

    String dbUrl = "jdbc:mysql://" + dbHost + ":" + dbPort + "/" + dbName
            + "?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true";
%>
<sql:setDataSource var="empleados"
                   driver="com.mysql.cj.jdbc.Driver"
                   url="<%= dbUrl %>"
                   user="<%= dbUser %>"
                   password="<%= dbPass %>" />
